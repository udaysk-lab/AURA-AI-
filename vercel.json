{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": [
        "hnd1"
    ],
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "app.main:app"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(docs|redoc|openapi.json|health)(/.*)?",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ],
    "crons": [
        {
            "path": "/api/cron/tick",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/tick",
            "schedule": "0 9 * * *"
        },
        {
            "path": "/api/cron/tick",
            "schedule": "0 17 * * *"
        }
    ]
}
