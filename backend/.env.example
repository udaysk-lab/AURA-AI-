# Backend configuration. Copy to backend/.env for local development.
#
# Every value has a safe default — the app boots with this file entirely empty.
# Adding credentials upgrades AURA from demo mode to live mode.
#
# On the hosted site these go in Vercel → Settings → Environment Variables
# (see DEPLOY.md), NOT in a .env file. Settings are read once at startup, so
# redeploy after any change.
#
# The settings for running AURA on your own computer (LOCAL_MODE, the device
# controls, remote access) are explained in the .env.example at the repo root.

# --- Core -------------------------------------------------------------------
# local | staging | production
#
# `production` makes main.py refuse to boot while any preflight check fails, and
# it forbids demo login. Use `staging` for a deployed demo: the same warnings
# are logged, but the service still serves and password-free login keeps working.
ENVIRONMENT=local
DEBUG=true

# SQLite is the zero-setup default. Anything deployed wants Postgres — a bare
# postgresql:// or legacy postgres:// URL is rewritten to the psycopg 3 dialect
# automatically, so paste whatever your host gives you.
DATABASE_URL=sqlite:///./aura.db
# The schema is created and upgraded automatically at start-up (docs/MIGRATIONS.md).
# If your host locks DATABASE_URL, set this instead; when set, it wins.
# DATABASE_URL_OVERRIDE=

# --- Security ---------------------------------------------------------------
# Required outside local. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts OAuth refresh tokens and vault secrets at rest. Without it the key is
# derived from SECRET_KEY, which means rotating SECRET_KEY silently destroys
# every stored credential. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Origins ----------------------------------------------------------------
# CORS_ORIGINS must contain the frontend's exact origin — scheme, host, no
# trailing slash. Comma-separate several. Locally, any localhost port is trusted
# automatically; outside local this list is the entire policy.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Sign-in ----------------------------------------------------------------
# Password-free: anyone who knows an email address can sign in as that user.
# Fine for a demo, never for real data. Must be false in production.
ALLOW_DEMO_LOGIN=true

# --- Model provider ---------------------------------------------------------
# Without one of these AURA runs an offline keyword router — every screen works,
# but there's no real reasoning. Required in production.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Any OpenAI-compatible endpoint. Ollama and LM Studio are free and local:
#   Ollama      http://localhost:11434/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Optional. Used ONLY for embeddings: makes memory and document search match
# meaning instead of words.
EMBEDDING_MODEL=text-embedding-3-small

# Tasks that start without a person in the chat (schedules and inbound channel
# messages) run far more often than anyone chats and need less judgement. Pointing
# them at a smaller model is the biggest saving available. Blank = same model as chat.
BACKGROUND_MODEL=

# The model for Auto mode's safety reviewer, one call for each action that would
# have asked. Blank = BACKGROUND_MODEL, then the main model. Auto needs a real
# model; with the offline demo it acts as Ask first.
REVIEWER_MODEL=

# --- The task loop ----------------------------------------------------------
# Model calls in one stretch of work, and in one whole task across every stretch.
MAX_AGENT_STEPS=8
MAX_TASK_STEPS=40
# After this many seconds in one request a task starts no new model call and
# carries on afterwards. Keep it under your platform's request limit.
SEGMENT_SECONDS=200
# How long background work leaves a paused chat task alone so the open page can
# continue it first.
RESUME_GRACE_SECONDS=60

# --- Spend guard ------------------------------------------------------------
DAILY_SPEND_CAP_USD=5.0
SPEND_CAP_ENABLED=true

# --- Google OAuth -----------------------------------------------------------
# Redirect URI to register: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Heartbeat --------------------------------------------------------------
HEARTBEAT_ENABLED=true

# --- Background work on Vercel ------------------------------------------------
# Vercel has no long-running process for worker.py, so vercel.json's crons call
# /api/cron/tick instead. With this set (any long random string) each call also
# runs the worker's loops; Vercel sends it automatically. Without it the
# endpoint only keeps the database awake.
CRON_SECRET=
# A tick starts no new work after this many seconds and leaves the rest for the
# next one.
CRON_BUDGET_SECONDS=240

# --- Rate limiting ----------------------------------------------------------
# Without Redis each worker keeps its own counters, so the real limit is N times
# what's configured here.
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=20
RATE_LIMIT_INBOUND_PER_MINUTE=15

# --- Optional ---------------------------------------------------------------
# Web research: brave | serper | tavily. Without a key, research falls back to
# the user's own data and says so rather than inventing sources.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Outbound email when Google isn't connected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
