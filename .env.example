# ---------------------------------------------------------------------------
# Copy to .env in the project root (the backend reads ../.env too).
# Every value below has a working default, so you can run AURA with none of them.
# Settings are read once at start-up: restart after changing one.
#
# Permissions are not set here. The permission mode, rules, connected folders and
# app access are chosen by the signed-in user in the app (Settings, Permissions;
# This computer) and apply at once. See docs/PERMISSIONS.md. The settings below
# that touch the computer are ceilings the app cannot go above.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# local | staging | production. Production refuses to start while a blocking
# preflight check fails (see /api/health/preflight).
ENVIRONMENT=local
DEBUG=true
# Shown in the API's title and logs.
APP_NAME=AURA AI

# --- Database -----------------------------------------------------------------
# Default is file-backed SQLite: zero setup. The schema is created and upgraded
# automatically at start-up; there is nothing to run (docs/MIGRATIONS.md).
DATABASE_URL=sqlite:///./aura.db
# With docker compose:
# DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura
# A host that attaches its own database may lock DATABASE_URL. Set this to use a
# different one; when set, it wins over DATABASE_URL.
# DATABASE_URL_OVERRIDE=

# --- Security -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
# How long a sign-in lasts, in minutes (default: 7 days).
ACCESS_TOKEN_TTL_MINUTES=10080

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev and it is derived from SECRET_KEY. Set it in production.
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Model provider -------------------------------------------------------------
# auto | anthropic | openai | mock.
# "auto" prefers Anthropic, then OpenAI, then the offline mock.
#
# Get a Claude key at https://console.anthropic.com -> API Keys (billing required).
# This is a server credential: it belongs here, not in the in-app vault. See DEPLOY.md.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Used ONLY for embeddings: makes memory and document search match
# meaning instead of words. The chosen provider still does the reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Any OpenAI-compatible endpoint (Ollama http://localhost:11434/v1, LM Studio,
# Groq, DeepSeek, OpenRouter). Semantic search is off while this is set.
OPENAI_BASE_URL=

# A smaller model for tasks that start without you in the chat (schedules and
# inbound channel messages). Blank = the same model as chat.
BACKGROUND_MODEL=
# The model for Auto mode's safety reviewer, a separate call for each action
# that would have asked. Blank = BACKGROUND_MODEL, then the main model.
REVIEWER_MODEL=

# --- The task loop ----------------------------------------------------------------
# Model calls in one stretch of work before the task pauses and carries on.
MAX_AGENT_STEPS=8
# Model calls in one whole task, across every stretch. At the limit AURA stops and
# says where it stands.
MAX_TASK_STEPS=40
# After this many seconds in one stretch AURA starts no new model call and the task
# carries on afterwards. On a host with a request time limit, keep it well under it.
SEGMENT_SECONDS=200
# How long the worker leaves a paused chat task alone so the open page can continue
# it first.
RESUME_GRACE_SECONDS=60

# --- Spend guard -----------------------------------------------------------------
# A tool loop plus a heartbeat can spend money unattended. Past the cap the agent
# refuses rather than continuing. Background work gets 40% of this.
SPEND_CAP_ENABLED=true
DAILY_SPEND_CAP_USD=5.0

# --- Rate limiting -------------------------------------------------------------------
# Leave REDIS_URL blank for in-process counters (fine for one worker).
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=20
RATE_LIMIT_INBOUND_PER_MINUTE=15

# --- Outbound email ----------------------------------------------------------------
# Without these AND without Google connected, send_email reports honestly that it
# could not send rather than pretending it did.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Google OAuth (optional) -------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI: http://localhost:8000/api/auth/google/callback
# Enable the Gmail API and Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The permissions requested from Google, space-separated. The default covers sign-in,
# Gmail and Calendar; change it only if you know why.
# GOOGLE_SCOPES=

# --- Behaviour ---------------------------------------------------------------------
# Password-free sign-in. Turn this off in production. A local install ignores it.
ALLOW_DEMO_LOGIN=true

# --- Heartbeat ---------------------------------------------------------------------
# AURA's own background checks while you are away. Needs the worker:
#   cd backend && python worker.py
HEARTBEAT_ENABLED=true

# --- Web research (Research system) ---------------------------------------------------
# brave | serper | tavily. Without a key, research falls back to the user's own
# data and says so rather than inventing sources.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Documents -----------------------------------------------------------------------
MAX_UPLOAD_MB=20

# --- Hosted background work ------------------------------------------------------------
# On Vercel the crons in vercel.json call /api/cron/tick. With this set (any long
# random string) each call also runs the worker, including continuing tasks that
# are ready; Vercel sends it automatically.
CRON_SECRET=
# A tick starts no new work after this many seconds and leaves the rest for the
# next one. Keep it under the platform's request limit.
CRON_BUDGET_SECONDS=240

# --- Working on this computer (local installs) ---------------------------------------------
# The switch that turns AURA from an assistant that works in its own workspace into
# one that works on the computer it is installed on: commands, files in connected
# folders, apps, and the screen, mouse and keyboard.
#
# Only turn this on for a machine that is YOURS and that you sit at. On a shared or
# public deployment it must stay off: startup refuses it in production.
#
# The local launchers (start-aura-local.bat / aura-local.sh) set this for you.
# Which folders, apps and actions are allowed is then chosen in the app (This
# computer, Settings, Permissions). See DEVICE.md.
LOCAL_MODE=false

# Override the above on its own: on | off. Blank follows LOCAL_MODE.
# "off" keeps a local install chat-only.
DEVICE_CONTROL=

# A CEILING on connected folders. Blank = no ceiling. When set (comma-separated),
# only folders inside these can be connected; one outside is ignored even if it was
# connected. Folders themselves are connected in the app, not here.
#   DEVICE_ALLOWED_ROOTS=C:\Users\you\projects,C:\Users\you\Documents
DEVICE_ALLOWED_ROOTS=

# Never touched, whatever is connected. Keys and credentials; the default is
# ~/.ssh, ~/.aws, ~/.gnupg, ~/.config/gcloud, ~/.kube, ~/.docker/config.json.
# Start-up items, shell profiles, git's own config and AURA's own folder are
# protected on top of this whatever it says.
# DEVICE_PROTECTED_PATHS=~/.ssh,~/.aws,~/.gnupg,~/.config/gcloud,~/.kube,~/.docker/config.json
# More protected paths, without restating the defaults above.
DEVICE_EXTRA_PROTECTED_PATHS=

# Commands containing any of these (comma-separated, case-insensitive) are refused
# outright, in every mode, even after approval. Empty by default.
# DEVICE_COMMAND_DENYLIST=shutdown,mkfs,diskpart,dd if=
DEVICE_COMMAND_DENYLIST=

# A foreground command is stopped after this many seconds. Long work goes in the
# background instead, where AURA polls it.
DEVICE_EXEC_TIMEOUT_SECONDS=300

# The most bytes one file read or command output returns to the model.
DEVICE_MAX_READ_BYTES=200000

# false removes screenshots, mouse and keyboard altogether. When true, each user
# still switches it on or off, and allows each app, in the app. Needs a desktop
# session and the extras in backend/requirements-device.txt.
DEVICE_SCREEN_CONTROL=true

# Run the background worker (heartbeat, schedules, automations, continuing tasks,
# compaction) inside the API process, so one launch does everything. Blank follows
# LOCAL_MODE. A real server runs worker.py separately and sets this to off.
RUN_EMBEDDED_WORKER=

# --- AURA's own folder and sign-in (local installs) --------------------------------------------
# Where a local install keeps background-command output, its sign-in key and, for
# the desktop app, everything: aura.db, aura.env, logs. Blank = ~/.aura. Protected
# from AURA's own file tools and commands.
AURA_HOME=
# The settings file the in-app "AI model" and "Remote access" screens write to.
# Blank = this .env when running from source.
# AURA_CONFIG_FILE=
# The key that signing in to a local install needs, so another account on the same
# computer cannot sign in as you. The desktop app makes one in aura.env; from source
# AURA makes ~/.aura/local-login.key. Set it only to choose your own.
# AURA_LOCAL_LOGIN_KEY=
# Host names a local install answers to; any other Host header is refused.
LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- Remote access (local installs) -----------------------------------------------------------
# Lets a paired phone or laptop use this computer's AURA over your network or a
# tunnel like Tailscale. Pair devices from Settings, Use AURA from your phone.
# The desktop app listens beyond 127.0.0.1 only when this is on. Traffic on your
# network is not encrypted: use a network you trust, or Tailscale.
REMOTE_ACCESS=false
# Extra names this computer answers to, shown when pairing (e.g. a Tailscale name).
REMOTE_HOSTNAMES=
# Days a paired device stays signed in before it must pair again.
REMOTE_SESSION_DAYS=30
