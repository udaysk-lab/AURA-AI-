# ---------------------------------------------------------------------------
# Copy to .env in the project root (the backend reads ../.env too).
# Every value below has a working default — you can run AURA with none of them.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# --- Database --------------------------------------------------------------
# Default is file-backed SQLite: zero setup.
DATABASE_URL=sqlite:///./aura.db
# With docker compose:
# DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura

# --- Security --------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev and it is derived from SECRET_KEY. Set it in production.
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Model provider --------------------------------------------------------
# auto | anthropic | openai | mock.
# "auto" prefers Anthropic, then OpenAI, then the offline mock agent.
#
# Get a Claude key at https://console.anthropic.com → API Keys (billing required).
# This is a server credential: it belongs here, not in the in-app vault. See DEPLOY.md.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Used ONLY for embeddings — makes memory and document search match
# meaning instead of keywords. Claude still does all the reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_AGENT_STEPS=8

# --- Spend guard -----------------------------------------------------------
# A tool loop plus a heartbeat can spend money unattended. Past the cap the
# agent refuses rather than continuing. Background work gets 40% of this.
SPEND_CAP_ENABLED=true
DAILY_SPEND_CAP_USD=5.0

# --- Rate limiting ---------------------------------------------------------
# Leave REDIS_URL blank for in-process counters (fine for one worker).
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=20
RATE_LIMIT_INBOUND_PER_MINUTE=15

# --- Outbound email --------------------------------------------------------
# Without these AND without Google connected, send_email reports honestly that
# it couldn't send rather than pretending it did.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Google OAuth (optional) -----------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI: http://localhost:8000/api/auth/google/callback
# Enable the Gmail API and Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Behaviour -------------------------------------------------------------
# Reference list of irreversible tools. The real gate is the user's autonomy
# tier plus any standing grants — see backend/app/agent/autonomy.py.
DESTRUCTIVE_TOOLS=send_email,archive_email,delete_event,delete_task

# Default trust tier for new accounts: strict | conservative | relaxed | full
DEFAULT_AUTONOMY_LEVEL=conservative

# Turn this off in production.
ALLOW_DEMO_LOGIN=true

# --- Heartbeat ---------------------------------------------------------------
# The background loop that works while the user is away. Requires the worker:
#   cd backend && python worker.py
HEARTBEAT_ENABLED=true
HEARTBEAT_DEFAULT_INTERVAL_MINUTES=30
HEARTBEAT_DEFAULT_QUIET_HOURS=22:00-07:00

# --- Web research (Research plugin) ------------------------------------------
# brave | serper | tavily. Without a key, research falls back to the user's own
# data and says so rather than inventing sources.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Documents ---------------------------------------------------------------
MAX_UPLOAD_MB=20

# --- Local device control ----------------------------------------------------
# This is the switch that turns AURA from an assistant that talks about your
# work into one that operates the computer it's installed on: it runs commands,
# reads and writes your files, opens apps, watches the system, and can see the
# screen and drive the mouse and keyboard.
#
# Only ever turn this on for a machine that is YOURS and that you're sitting at.
# It gives the agent your hands on that computer. On a shared or public
# deployment it must stay off — startup refuses it outright in production.
#
# The local launchers (start-aura-local.bat / aura-local.sh) set this for you.
LOCAL_MODE=false

# Override the above on its own: on | off. Blank follows LOCAL_MODE.
# Use "off" to run a local install chat-only.
DEVICE_CONTROL=

# Folders the file tools may read and write. Comma-separated. Blank = your home
# directory. Paths resolve to real absolute paths and are checked against this
# list, so .. and symlinks can't escape it.
#
# Narrow this if you want AURA working on one project rather than everything:
#   DEVICE_ALLOWED_ROOTS=C:\Users\you\projects,C:\Users\you\Documents
#
# Note this fences the FILE tools. A shell command runs with your user's full
# authority and can reach anything you can — what holds the shell back is the
# approval gate in front of it, below.
DEVICE_ALLOWED_ROOTS=

# Never touched, even inside an allowed root. Keys and credentials.
DEVICE_PROTECTED_PATHS=~/.ssh,~/.aws,~/.gnupg,~/.config/gcloud,~/.kube,~/.docker/config.json,~/.aura

# How shell commands get approved, on top of your autonomy tier:
#   ask        every command is previewed and queued for your approval, unless
#              you've granted that command standing permission (default)
#   allowlist  commands matching DEVICE_EXEC_ALLOWLIST run on their own
#   full       commands run without asking
DEVICE_EXEC_MODE=ask

# Command prefixes that may run without approval under allowlist mode.
# DEVICE_EXEC_ALLOWLIST=git status,git diff,git log,ls,cat,npm run build
DEVICE_EXEC_ALLOWLIST=

# Commands refused outright — even after approval, even at full trust. The last
# stop against a catastrophic instruction. Empty by default.
# DEVICE_COMMAND_DENYLIST=shutdown,mkfs,diskpart,dd if=
DEVICE_COMMAND_DENYLIST=

# A foreground command is killed after this long. Long work goes in the
# background instead, where AURA polls it.
DEVICE_EXEC_TIMEOUT_SECONDS=300

# Ceiling on bytes returned from one file read or command, so a huge file can't
# flood the model's context.
DEVICE_MAX_READ_BYTES=200000

# Let AURA see the screen and drive the mouse/keyboard. Needs a desktop session
# and the extras in backend/requirements-device.txt.
DEVICE_SCREEN_CONTROL=true

# Run the background worker (heartbeat, schedules, automations, compaction)
# inside the API process, so one launch does everything. Blank follows
# LOCAL_MODE. A real server should run worker.py separately and set this off.
RUN_EMBEDDED_WORKER=
