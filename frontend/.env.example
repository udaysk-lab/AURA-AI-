# Frontend configuration.
#
# Copy to .env.local for local development. On Vercel, set these in
# Settings → Environment Variables instead — .env files aren't deployed.
#
# NEXT_PUBLIC_ vars are inlined into the JavaScript bundle at BUILD time, not
# read at runtime. Changing one in Vercel requires a redeploy to take effect.

# Where the FastAPI backend lives. No trailing slash.
#
#   Local:      http://localhost:8000
#   Deployed:   https://aura-api.onrender.com
#
# If this is unset the client falls back to http://localhost:8000 — which on a
# deployed site means the browser tries to reach the *visitor's* machine, and
# every request fails.
NEXT_PUBLIC_API_URL=http://localhost:8000
