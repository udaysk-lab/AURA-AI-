# Frontend configuration.
#
# Copy to .env.local for local development. On Vercel, set these in
# Settings → Environment Variables instead — .env files aren't deployed.
#
# NEXT_PUBLIC_ vars are inlined into the JavaScript bundle at BUILD time, not
# read at runtime. Changing one in Vercel requires a redeploy to take effect.

# Where the FastAPI backend lives. No trailing slash.
#
#   Local development (npm run dev):   http://localhost:8000
#   Vercel:                            leave it unset — vercel.json routes /api
#                                      to the backend on the same domain
#   Desktop build (npm run build:desktop): ignored; the app is served by the
#                                      backend itself, from the same address
#
# Unset, the browser calls the page's own origin, which is right whenever
# something in front of the app routes /api to the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
