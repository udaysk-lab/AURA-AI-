# ---------------------------------------------------------------------------
# Production environment. See DEPLOY.md.
#
# Do not commit the filled-in version. Inject these through your platform's
# secret manager. With ENVIRONMENT=production the app refuses to start while any
# blocking preflight check fails — check /api/health/preflight if it won't boot.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# --- Secrets (generate fresh, never reuse across environments) --------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this explicitly. If it's derived from SECRET_KEY, rotating SECRET_KEY makes
# every stored OAuth token and vault secret permanently unreadable.
TOKEN_ENCRYPTION_KEY=

# --- Model ------------------------------------------------------------------
# https://console.anthropic.com → API Keys. Requires billing on the account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional, embeddings only — makes memory and document search match meaning
# rather than keywords. Claude still does all the reasoning.
OPENAI_API_KEY=

# --- Spend guard ------------------------------------------------------------
# The backstop against a runaway agent loop or a leaked channel token. Set a
# billing alert in the Anthropic console too — don't rely on this alone.
SPEND_CAP_ENABLED=true
DAILY_SPEND_CAP_USD=5.0

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://aura:CHANGE_ME@db-host:5432/aura
# Alembic owns the schema in production. Run `alembic upgrade head` before boot.
AUTO_CREATE_SCHEMA=false

# --- URLs and CORS ----------------------------------------------------------
FRONTEND_URL=https://aura.yourdomain.com
BACKEND_URL=https://api.yourdomain.com
# Exact origins only. Never "*" while allow_credentials is on.
CORS_ORIGINS=https://aura.yourdomain.com

# --- Rate limiting ----------------------------------------------------------
# Without REDIS_URL each worker keeps its own counters, so the real limit is
# (workers × configured). Inbound webhooks are the exposed surface here.
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://redis-host:6379/0
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=20
RATE_LIMIT_INBOUND_PER_MINUTE=15

# --- Authentication ---------------------------------------------------------
# Password-free login. MUST be false in production.
ALLOW_DEMO_LOGIN=false

# Google Cloud Console → OAuth 2.0 Client (Web).
# Redirect URI: https://api.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outbound email ---------------------------------------------------------
# Only needed if users won't connect Gmail. Configure SPF/DKIM/DMARC on the
# sending domain or the mail will be filtered as spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Web research (Research plugin) -----------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Background work --------------------------------------------------------
# Run exactly one worker process. Schedule de-duplication is per-process.
HEARTBEAT_ENABLED=true
HEARTBEAT_DEFAULT_INTERVAL_MINUTES=30
HEARTBEAT_DEFAULT_QUIET_HOURS=22:00-07:00

# --- Behaviour --------------------------------------------------------------
DEFAULT_AUTONOMY_LEVEL=conservative
DESTRUCTIVE_TOOLS=send_email,archive_email,delete_event,delete_task
MAX_AGENT_STEPS=8
MAX_UPLOAD_MB=20
