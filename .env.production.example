# ---------------------------------------------------------------------------
# Production environment. See DEPLOY.md.
#
# Do not commit the filled-in version. Inject these through your platform's
# secret manager. With ENVIRONMENT=production the app refuses to start while any
# blocking preflight check fails — check /api/health/preflight if it won't boot.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# --- Secrets (generate fresh, never reuse across environments) --------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this explicitly. If it's derived from SECRET_KEY, rotating SECRET_KEY makes
# every stored OAuth token and vault secret permanently unreadable.
TOKEN_ENCRYPTION_KEY=

# --- Model ------------------------------------------------------------------
# https://console.anthropic.com → API Keys. Requires billing on the account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional, embeddings only: makes memory and document search match meaning
# rather than words. The chosen provider still does all the reasoning.
OPENAI_API_KEY=

# Optional smaller model for tasks that start without a person in the chat
# (schedules and inbound channel messages). Blank = the main model.
BACKGROUND_MODEL=
# The model for Auto mode's safety reviewer, one call for each action that would
# have asked. Blank = BACKGROUND_MODEL, then the main model. Auto needs a real
# model; with none configured it acts as Ask first.
REVIEWER_MODEL=

# --- The task loop ----------------------------------------------------------
# Model calls in one stretch of work, and in one whole task.
MAX_AGENT_STEPS=8
MAX_TASK_STEPS=40
# After this many seconds in one request a task starts no new model call and
# carries on afterwards. Keep it well under the platform's request limit (300 s
# on Vercel).
SEGMENT_SECONDS=200
# How long background work leaves a paused chat task alone so the open page can
# continue it first.
RESUME_GRACE_SECONDS=60

# --- Spend guard ------------------------------------------------------------
# The backstop against a runaway agent loop or a leaked channel token. Set a
# billing alert in the Anthropic console too — don't rely on this alone.
SPEND_CAP_ENABLED=true
DAILY_SPEND_CAP_USD=5.0

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://aura:CHANGE_ME@db-host:5432/aura
# If the host locks DATABASE_URL (a Vercel storage integration does), set this
# instead; when set, it wins.
# DATABASE_URL_OVERRIDE=
# The schema is upgraded automatically at start-up, under a lock; there is nothing
# to set or run. Back the database up before a release that adds a revision (AURA
# only backs up SQLite). See DEPLOY.md, Database migrations, and docs/MIGRATIONS.md.

# --- URLs and CORS ----------------------------------------------------------
FRONTEND_URL=https://aura.yourdomain.com
BACKEND_URL=https://api.yourdomain.com
# Exact origins only. Never "*" while allow_credentials is on.
CORS_ORIGINS=https://aura.yourdomain.com

# --- Rate limiting ----------------------------------------------------------
# Without REDIS_URL each worker keeps its own counters, so the real limit is
# (workers × configured). Inbound webhooks are the exposed surface here.
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://redis-host:6379/0
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=20
RATE_LIMIT_INBOUND_PER_MINUTE=15

# --- Authentication ---------------------------------------------------------
# Password-free login. MUST be false in production.
ALLOW_DEMO_LOGIN=false

# Google Cloud Console → OAuth 2.0 Client (Web).
# Redirect URI: https://api.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outbound email ---------------------------------------------------------
# Only needed if users won't connect Gmail. Configure SPF/DKIM/DMARC on the
# sending domain or the mail will be filtered as spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Web research (Research plugin) -----------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Background work --------------------------------------------------------
# On a server: run exactly one worker process (python worker.py). Schedule
# de-duplication is per-process.
HEARTBEAT_ENABLED=true
# On Vercel there is no worker process: vercel.json's crons call
# /api/cron/tick, and with this set each call runs the worker's loops, including
# continuing tasks that are ready.
CRON_SECRET=
# A tick starts no new work after this many seconds and leaves the rest for the
# next one. Keep it under the platform's request limit.
CRON_BUDGET_SECONDS=240

# --- Never on a shared deployment -------------------------------------------
# LOCAL_MODE, DEVICE_CONTROL and REMOTE_ACCESS are for AURA running on someone's
# own computer. Leave them, and every DEVICE_* setting, unset here; startup
# refuses device control in production.

# --- Behaviour --------------------------------------------------------------
MAX_UPLOAD_MB=20
